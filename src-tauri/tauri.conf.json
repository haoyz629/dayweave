{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "今序 · Dayweave",
  "version": "0.1.0",
  "identifier": "com.dayweave.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "create": false, "title": "今序 · Dayweave", "decorations": false, "width": 1280, "height": 800, "minWidth": 960, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' https: http:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "今序",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": { "nsis": { "displayLanguageSelector": true, "installerHooks": "windows/installer-hooks.nsh" } }
  }
}
